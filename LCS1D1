            // Elementos del DOM
            const questionScreen = document.getElementById('question-screen');
            const explanationScreen = document.getElementById('explanation-screen');
            const resultsScreen = document.getElementById('results-screen');
            const progressText = document.getElementById('progress-text');
            const scoreText = document.getElementById('score-text');
            const progressFill = document.getElementById('progress-fill');
            const questionNumber = document.getElementById('question-number');
            const textPassage = document.getElementById('text-passage');
            const questionText = document.getElementById('question-text');
            const optionsContainer = document.getElementById('options-container');
            const hintBtn = document.getElementById('hint-btn');
            const hintBox = document.getElementById('hint-box');
            const hintText = document.getElementById('hint-text');
            const prevBtn = document.getElementById('prev-btn');
            const checkBtn = document.getElementById('check-btn');
            const backToQuestionBtn = document.getElementById('back-to-question-btn');
            const nextQuestionBtn = document.getElementById('next-question-btn');
            const retryBtn = document.getElementById('retry-btn');
            const continueBtn = document.getElementById('continue-btn');
            const backBtn = document.getElementById('back-btn');
            const hamburgerMenu = document.getElementById('hamburger-menu');
            const userDropdown = document.getElementById('user-dropdown');
            const logoutBtn = document.getElementById('logout-btn');
            const toast = document.getElementById('toast');
            
            // Inicializar cuestionario
            function initializeQuiz() {
                currentQuestion = 0;
                score = 0;
                selectedOption = null;
                hintsUsed = 0;
                answers = [];
                
                // Cargar progreso guardado si existe
                const savedProgress = localStorage.getItem('quizProgress');
                if (savedProgress) {
                    const progress = JSON.parse(savedProgress);
                    if (progress.quizId === 'LCS1D1') {
                        currentQuestion = progress.currentQuestion || 0;
                        score = progress.score || 0;
                        hintsUsed = progress.hintsUsed || 0;
                        answers = progress.answers || [];
                    }
                }
                
                loadQuestion();
                updateProgress();
            }
            
            // Cargar pregunta actual
            function loadQuestion() {
                if (currentQuestion >= questions.length) {
                    showResults();
                    return;
                }
                
                const question = questions[currentQuestion];
                selectedOption = answers[currentQuestion] !== undefined ? answers[currentQuestion] : null;
                
                // Actualizar UI
                questionNumber.textContent = `Pregunta ${currentQuestion + 1}`;
                progressText.textContent = `Pregunta ${currentQuestion + 1} de ${questions.length}`;
                scoreText.textContent = `Puntuación: ${score}`;
                
                // Separar el texto del pasaje y la pregunta
                const parts = question.pregunta.split('\n\nPregunta: ');
                textPassage.textContent = parts[0];
                questionText.textContent = parts[1] || question.pregunta;
                
                // Cargar opciones
                optionsContainer.innerHTML = '';
                question.opciones.forEach((option, index) => {
                    const optionBtn = document.createElement('button');
                    optionBtn.className = 'option-btn';
                    if (selectedOption !== null && selectedOption === index) {
                        optionBtn.classList.add('selected');
                    }
                    optionBtn.innerHTML = `
                        <span class="option-letter">${String.fromCharCode(65 + index)}</span>
                        <span>${option}</span>
                    `;
                    optionBtn.onclick = () => selectOption(index);
                    optionsContainer.appendChild(optionBtn);
                });
                
                // Ocultar pista
                hintBox.classList.remove('show');
                
                // Actualizar botones
                prevBtn.disabled = currentQuestion === 0;
                checkBtn.disabled = selectedOption === null;
                
                // Mostrar pantalla de pregunta
                questionScreen.style.display = 'block';
                explanationScreen.style.display = 'none';
                resultsScreen.style.display = 'none';
            }
            
            // Seleccionar opción
            function selectOption(index) {
                selectedOption = index;
                const options = document.querySelectorAll('.option-btn');
                options.forEach((opt, i) => {
                    opt.classList.toggle('selected', i === index);
                });
                checkBtn.disabled = false;
            }
            
            // Mostrar pista
            hintBtn.addEventListener('click', () => {
                if (hintBox.classList.contains('show')) {
                    hintBox.classList.remove('show');
                } else {
                    // Generar pista basada en la pregunta
                    const question = questions[currentQuestion];
                    const correctOption = question.opciones[question.respuestaCorrecta];
                    
                    // Extraer palabras clave de la respuesta correcta
                    const keywords = correctOption.split(' ').filter(word => word.length > 4).slice(0, 3);
                    hintText.textContent = `Fíjate en las palabras clave: ${keywords.join(', ')}. La idea principal suele ser la opción más completa que resume varios aspectos del texto.`;
                    
                    hintBox.classList.add('show');
                    hintsUsed++;
                }
            });
            
            // Verificar respuesta
            checkBtn.addEventListener('click', () => {
                if (selectedOption === null) return;
                
                const question = questions[currentQuestion];
                const isCorrect = selectedOption === question.respuestaCorrecta;
                
                // Guardar respuesta
                answers[currentQuestion] = selectedOption;
                if (isCorrect) {
                    score += 10 - hintsUsed; // Menos puntos si se usaron pistas
                }
                
                // Mostrar resultados en las opciones
                const options = document.querySelectorAll('.option-btn');
                options.forEach((opt, i) => {
                    if (i === question.respuestaCorrecta) {
                        opt.classList.add('correct');
                    } else if (i === selectedOption && i !== question.respuestaCorrecta) {
                        opt.classList.add('incorrect');
                    }
                    opt.onclick = null; // Deshabilitar clics
                });
                
                // Guardar progreso
                saveProgress();
                
                // Mostrar pantalla de explicación
                setTimeout(() => {
                    showExplanation(isCorrect);
                }, 1000);
            });
            
            // Mostrar explicación
            function showExplanation(isCorrect) {
                const question = questions[currentQuestion];
                
                // Actualizar UI de explicación
                const resultIcon = document.getElementById('result-icon');
                const resultTitle = document.getElementById('result-title');
                const explanationText = document.getElementById('explanation-text');
                const tipText = document.getElementById('tip-text');
                
                if (isCorrect) {
                    resultIcon.innerHTML = '✅';
                    resultIcon.className = 'result-icon correct';
                    resultTitle.textContent = '¡Correcto!';
                    resultTitle.className = 'result-title correct';
                } else {
                    resultIcon.innerHTML = '❌';
                    resultIcon.className = 'result-icon incorrect';
                    resultTitle.textContent = 'Incorrecto';
                    resultTitle.className = 'result-title incorrect';
                }
                
                explanationText.textContent = question.explicacion;
                tipText.textContent = question.truco;
                
                // Actualizar botones
                if (currentQuestion > 0) {
                    backToQuestionBtn.style.display = 'block';
                } else {
                    backToQuestionBtn.style.display = 'none';
                }
                
                if (currentQuestion < questions.length - 1) {
                    nextQuestionBtn.innerHTML = 'Siguiente <i class="fas fa-arrow-right"></i>';
                } else {
                    nextQuestionBtn.innerHTML = 'Ver resultados <i class="fas fa-trophy"></i>';
                }
                
                // Mostrar pantalla de explicación
                questionScreen.style.display = 'none';
                explanationScreen.style.display = 'block';
                resultsScreen.style.display = 'none';
            }
            
            // Navegación
            prevBtn.addEventListener('click', () => {
                if (currentQuestion > 0) {
                    currentQuestion--;
                    loadQuestion();
                }
            });
            
            backToQuestionBtn.addEventListener('click', () => {
                loadQuestion();
            });
            
            nextQuestionBtn.addEventListener('click', () => {
                currentQuestion++;
                hintsUsed = 0; // Reiniciar contador de pistas para la siguiente pregunta
                loadQuestion();
            });
            
            // Mostrar resultados finales
            function showResults() {
                const percentage = Math.round((score / (questions.length * 10)) * 100);
                const correctAnswers = answers.filter((answer, index) => answer === questions[index].respuestaCorrecta).length;
                
                // Actualizar UI de resultados
                const resultsIcon = document.getElementById('results-icon');
                const resultsTitle = document.getElementById('results-title');
                const resultsScore = document.getElementById('results-score');
                const resultsMessage = document.getElementById('results-message');
                const starsContainer = document.getElementById('stars-container');
                const questionReview = document.getElementById('question-review');
                
                resultsScore.textContent = `${score}/${questions.length * 10}`;
                
                if (percentage >= 80) {
                    resultsIcon.innerHTML = '🏆';
                    resultsTitle.textContent = '¡Excelente trabajo!';
                    resultsMessage.textContent = 'Has dominado la identificación de ideas principales. ¡Sigue así!';
                    starsContainer.innerHTML = '⭐⭐⭐';
                } else if (percentage >= 60) {
                    resultsIcon.innerHTML = '👏';
                    resultsTitle.textContent = '¡Buen trabajo!';
                    resultsMessage.textContent = 'Tienes una buena comprensión. Repasa los detalles para mejorar.';
                    starsContainer.innerHTML = '⭐⭐';
                } else {
                    resultsIcon.innerHTML = '📚';
                    resultsTitle.textContent = 'Sigue practicando';
                    resultsMessage.textContent = 'Necesitas repasar el concepto. No te preocupes, ¡la práctica hace al maestro!';
                    starsContainer.innerHTML = '⭐';
                }
                
                // Generar revisión de preguntas
                questionReview.innerHTML = '<h3>Revisión de respuestas:</h3>';
                questions.forEach((question, index) => {
                    const isCorrect = answers[index] === question.respuestaCorrecta;
                    const reviewItem = document.createElement('div');
                    reviewItem.className = `review-item ${isCorrect ? 'correct' : 'incorrect'}`;
                    reviewItem.innerHTML = `
                        <div class="review-icon">${isCorrect ? '✅' : '❌'}</div>
                        <div class="review-text">Pregunta ${index + 1}: ${isCorrect ? 'Correcta' : 'Incorrecta'}</div>
                    `;
                    questionReview.appendChild(reviewItem);
                });
                
                // Guardar progreso final
                const finalProgress = {
                    quizId: 'LCS1D1',
                    completed: true,
                    score: score,
                    percentage: percentage,
                    correctAnswers: correctAnswers,
                    totalQuestions: questions.length,
                    timestamp: new Date().toISOString()
                };
                localStorage.setItem('quizProgress', JSON.stringify(finalProgress));
                
                // Completar misión si corresponde
                if (percentage >= 60) {
                    completeMission(1); // Misión de completar examen
                    if (percentage >= 80) {
                        completeMission(2); // Misión de buen puntaje
                    }
                }
                
                // Mostrar pantalla de resultados
                questionScreen.style.display = 'none';
                explanationScreen.style.display = 'none';
                resultsScreen.style.display = 'block';
            }
            
            // Guardar progreso
            function saveProgress() {
                const progress = {
                    quizId: 'LCS1D1',
                    currentQuestion: currentQuestion,
                    score: score,
                    hintsUsed: hintsUsed,
                    answers: answers,
                    timestamp: new Date().toISOString()
                };
                localStorage.setItem('quizProgress', JSON.stringify(progress));
            }
            
            // Reiniciar cuestionario
            retryBtn.addEventListener('click', () => {
                initializeQuiz();
            });
            
            // Continuar a la biblioteca
            continueBtn.addEventListener('click', () => {
                window.location.href = 'LCS1D.html';
            });
            
            // Volver a la biblioteca
            backBtn.addEventListener('click', () => {
                if (confirm('¿Estás seguro de que quieres volver? Perderás el progreso actual.')) {
                    window.location.href = 'LCS1D.html';
                }
            });
            
            // Actualizar barra de progreso
            function updateProgress() {
                const progress = ((currentQuestion + 1) / questions.length) * 100;
                progressFill.style.width = progress + '%';
            }
            
            // Funciones auxiliares
            function completeMission(missionId) {
                // Lógica para completar misiones
                console.log(`Misión ${missionId} completada`);
                showToast(`¡Misión ${missionId} completada!`);
            }
            
            function showToast(message, duration = 3000) {
                toast.textContent = message;
                toast.classList.add('show');
                setTimeout(() => {
                    toast.classList.remove('show');
                }, duration);
            }
            
            // Navegación y usuario
            hamburgerMenu.addEventListener('click', () => {
                userDropdown.classList.toggle('active');
            });
            
            logoutBtn.addEventListener('click', () => {
                import("https://www.gstatic.com/firebasejs/12.5.0/firebase-auth.js").then(({ signOut }) => {
                    signOut(window.auth).then(() => window.location.href = 'index.html');
                });
            });
            
            window.addEventListener('click', (event) => {
                if (!event.target.closest('.navbar')) {
                    userDropdown.classList.remove('active');
                }
            });
            
            // Floating icons
            document.getElementById('btn-misiones').addEventListener('click', () => {
                showToast('🎯 Misiones próximamente...');
            });
            
            document.getElementById('btn-nivel').addEventListener('click', () => {
                showToast('⭐ Nivel actual: Aprendiz');
            });
            
            document.getElementById('btn-progreso').addEventListener('click', () => {
                showToast('📊 Progreso general: 45%');
            });
        });
    </script>
